# Hackathon keys only work against this host. Staging and production return 401.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# Optional. The agent writes its reasoning in plainer prose without these.
# Any OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_MODEL=
# LLM_URL=https://api.openai.com/v1/chat/completions

# Optional. Leave blank to use data/cache. Do not set it to an empty value in
# a way that resolves to "." -- that is handled, but blank is cleanest.
# SLATE_CACHE_DIR=
